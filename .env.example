# Local host values for `go run ./cmd/wagering` against Compose dependencies.
# Copy to `.env` if you like; do not commit real secrets.
# Inside Docker Compose these are overridden with service DNS names (see docker-compose.yml).

LOG_LEVEL=info
HTTP_ADDR=:8080

POSTGRES_DSN=postgres://wagering:wagering@localhost:5432/wagering?sslmode=disable
MIGRATIONS_PATH=./migrations

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4566
AWS_EC2_METADATA_DISABLED=true

SQS_WAGER_QUEUE_NAME=wager-transactions.fifo
SQS_WAGER_DLQ_NAME=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE_NAME=wager-events.fifo

FX_START_TIMEOUT=15s
FX_STOP_TIMEOUT=30s

OUTBOX_POLL_INTERVAL=250ms
OUTBOX_BATCH_SIZE=10
OUTBOX_LEASE=30s
OUTBOX_BACKOFF_MAX=1m

SQS_VISIBILITY_TIMEOUT=30s
SQS_WAIT_TIME=20s
SQS_BACKOFF_MAX=20s

PENDING_POLL_INTERVAL=250ms
PENDING_BATCH_SIZE=10
PENDING_LEASE=30s
PENDING_BACKOFF_MAX=1m
PENDING_MAX_ATTEMPTS=8
PENDING_TTL=5m

OIDC_ISSUER=http://localhost:8081/realms/wagering
OIDC_AUDIENCE=wagering-api
OIDC_INTERNAL_CLIENT=wagering-internal
# OIDC_JWKS_URL is optional; defaults to {OIDC_ISSUER}/protocol/openid-connect/certs

# Keycloak (Compose). Local-only dummy admin and client secrets — see README:
#   host: http://localhost:8081
#   admin user / password: admin / admin
#   clients: wagering-internal / provider-a / provider-b
